<Window x:Class="TiendaOga.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tienda OGA - Login" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#363945">
    <!-- Fondo oscuro de la ventana -->

    <!-- Contenedor Principal (La Tarjeta del Login) -->
    <Border Width="340" Height="500" Background="#464958" CornerRadius="12" Padding="30">
        <!-- Sombra suave para dar relieve -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Direction="270" />
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <!-- Logo y Título -->
            <TextBlock Text="🏪" FontFamily="Segoe UI Emoji" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="TIENDA OGA" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,40" FontFamily="Segoe UI"/>

            <!-- Campo: Usuario -->
            <Border Background="#55586A" CornerRadius="6" Height="45" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="👤" FontFamily="Segoe UI Emoji" Foreground="#A0A4B8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                    <Border Grid.Column="0" BorderBrush="#6B6E80" BorderThickness="0,0,1,0" Margin="0,10,0,10"/>

                    <!-- x:Name agregado aquí -->
                    <TextBox x:Name="txtUsuario" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" ToolTip="Usuario"/>
                </Grid>
            </Border>

            <!-- Campo: Contraseña -->
            <Border Background="#55586A" CornerRadius="6" Height="45" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔑" FontFamily="Segoe UI Emoji" Foreground="#A0A4B8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                    <Border Grid.Column="0" BorderBrush="#6B6E80" BorderThickness="0,0,1,0" Margin="0,10,0,10"/>

                    <!-- x:Name agregado aquí -->
                    <PasswordBox x:Name="txtPassword" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" ToolTip="Contraseña"/>
                </Grid>
            </Border>

            <!-- Campo: Selección de Rol -->
            <Border Background="#55586A" CornerRadius="6" Height="45" Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🛡️" FontFamily="Segoe UI Emoji" Foreground="#A0A4B8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                    <Border Grid.Column="0" BorderBrush="#6B6E80" BorderThickness="0,0,1,0" Margin="0,10,0,10"/>

                    <!-- x:Name agregado aquí -->
                    <ComboBox x:Name="cmbRol" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="Black" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" Margin="5,0,0,0">
                        <ComboBoxItem Content="Vendedor" IsSelected="True"/>
                        <ComboBoxItem Content="Administrador"/>
                        <ComboBoxItem Content="Gerente"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Botón de Ingreso Redondo -->
            <!-- x:Name y Click agregados aquí -->
            <Button x:Name="btnIngresar" Click="btnIngresar_Click" Width="65" Height="65" Cursor="Hand" BorderThickness="0" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- El CornerRadius a la mitad del ancho/alto hace un círculo perfecto -->
                        <Border Background="#50D16E" CornerRadius="32.5">
                            <TextBlock Text="✓" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>