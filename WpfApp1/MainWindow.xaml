<Window x:Class="TiendaOga.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tienda OGA - Inicio de Sesion" Height="580" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Border Width="360" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="32" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="TIENDA OGA" Foreground="#FF6B00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Ingreso al Sistema" Foreground="#718096" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,30"/>

            <!-- Campo Usuario -->
            <TextBlock Text="Usuario" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="txtUsuario" Height="38" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Foreground="#2D3748" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Margin="0,0,0,16"/>

            <!-- Campo Contraseña -->
            <TextBlock Text="Contrasena" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="txtPassword" Height="38" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Foreground="#2D3748" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Margin="0,0,0,16"/>

            <!-- Campo Rol -->
            <TextBlock Text="Perfil / Rol" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="cmbRol" Height="38" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Foreground="#2D3748" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" Margin="0,0,0,24">
                <ComboBoxItem Content="Vendedor" IsSelected="True"/>
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Gerente"/>
            </ComboBox>

            <!-- Botón Ingresar -->
            <Button x:Name="btnIngresar" Click="btnIngresar_Click" Height="42" Background="#FF6B00" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderBtn" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="Ingresar" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderBtn" Property="Background" Value="#E05E00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>