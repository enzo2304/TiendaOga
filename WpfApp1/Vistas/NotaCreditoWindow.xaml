<Window x:Class="TiendaOga.Vistas.NotaCreditoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota de crédito" Width="720" SizeToContent="Height" MaxHeight="950"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F2F3F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" HorizontalAlignment="Center">

            <!-- Hoja de la nota de crédito (esto es lo que se imprime) -->
            <Border x:Name="Ticket" Width="640" Background="White"
                    BorderBrush="#444" BorderThickness="1"
                    TextElement.FontFamily="Arial" TextElement.FontSize="12">
                <StackPanel>

                    <!-- Encabezado -->
                    <Grid Height="115">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="14">
                            <TextBlock x:Name="txtComercio" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Nota de crédito por anulación de venta" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" BorderBrush="#444" BorderThickness="1,0,1,1">
                                <TextBlock Text="X" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Documento no válido como factura" FontSize="8"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="2,3,2,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="14">
                            <TextBlock Text="NOTA DE CRÉDITO" FontSize="16"/>
                            <TextBlock FontSize="22" Margin="0,4,0,0">
                                <Run Text="Nº "/><Run x:Name="txtNumeroNC"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Fecha" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Width="40" Height="24" BorderBrush="#444" BorderThickness="1" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtDia" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="40" Height="24" BorderBrush="#444" BorderThickness="1" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtMes" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="50" Height="24" BorderBrush="#444" BorderThickness="1">
                                    <TextBlock x:Name="txtAnio" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Datos del cliente / venta -->
                    <Border BorderBrush="#444" BorderThickness="0,1,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,2" TextWrapping="Wrap">
                                <Run Text="Señor(es): " FontWeight="SemiBold"/><Run x:Name="txtCliente"/>
                            </TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <Run x:Name="txtDocumento"/>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2">
                                <Run Text="Venta original: " FontWeight="SemiBold"/><Run x:Name="txtNumeroVenta"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <Run Text="Fecha de venta: " FontWeight="SemiBold"/><Run x:Name="txtFechaVenta"/>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,2">
                                <Run Text="Vendedor: " FontWeight="SemiBold"/><Run x:Name="txtVendedor"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <Run Text="Anulado por: " FontWeight="SemiBold"/><Run x:Name="txtAnulador"/>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,2" TextWrapping="Wrap">
                                <Run Text="Pago original: " FontWeight="SemiBold"/><Run x:Name="txtPago"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Encabezado de la tabla -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#999" BorderThickness="0,0,1,1" Padding="4">
                            <TextBlock Text="Cantidad" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#999" BorderThickness="0,0,1,1" Padding="4">
                            <TextBlock Text="D e s c r i p c i ó n" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#999" BorderThickness="0,0,1,1" Padding="4">
                            <TextBlock Text="P. Unitario" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#999" BorderThickness="0,0,0,1" Padding="4">
                            <TextBlock Text="Importe" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Filas -->
                    <ItemsControl x:Name="lstItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="#BBB" BorderThickness="0,0,1,1" Padding="4,3">
                                        <TextBlock Text="{Binding Cantidad}" TextAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#BBB" BorderThickness="0,0,1,1" Padding="6,3">
                                        <TextBlock Text="{Binding Producto}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="#BBB" BorderThickness="0,0,1,1" Padding="6,3">
                                        <TextBlock Text="{Binding Precio}" TextAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="#BBB" BorderThickness="0,0,0,1" Padding="6,3">
                                        <TextBlock Text="{Binding Subtotal}" TextAlignment="Right"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Totales -->
                    <Border BorderBrush="#444" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Subtotal  $" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" BorderBrush="#999" BorderThickness="1" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtSubtotal" TextAlignment="Right"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTAL  $" FontWeight="Bold" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" BorderBrush="#999" BorderThickness="1" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtTotal" FontWeight="Bold" TextAlignment="Right"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Pie -->
                    <Border BorderBrush="#444" BorderThickness="0,1,0,0" Padding="12" MinHeight="70">
                        <StackPanel>
                            <TextBlock Text="Se devolvió el stock de los productos al inventario."/>
                            <TextBlock Text="Comprobante no fiscal. No válido como factura." FontSize="10"
                                       FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Botones: quedan fuera de la hoja para que no se impriman -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Content="Imprimir" Width="110" Height="36" Margin="4"
                        Background="#1F3A5F" Foreground="White" FontWeight="Bold" Click="BtnImprimir_Click"/>
                <Button Content="Guardar PDF" Width="110" Height="36" Margin="4"
                        Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="BtnGuardarPdf_Click"/>
                <Button Content="Cerrar" Width="90" Height="36" Margin="4" Click="BtnCerrar_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
