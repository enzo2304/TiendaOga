<Page x:Class="TiendaOga.Vistas.Ventas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ventas">

    <!-- Contenedor del Formulario de Venta -->
    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nueva Venta" FontSize="22" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 0: Vendedor / Cliente -->
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 1: Selección de productos -->
                    <RowDefinition Height="*"/>
                    <!-- Fila 2: Grilla de detalle -->
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 3: Sección de Pago -->
                    <RowDefinition Height="Auto"/>
                    <!-- Fila 4: Total y botones -->
                </Grid.RowDefinitions>

                <!-- Fila 0: Vendedor y Cliente -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Vendedor:" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtVendedor" Height="30" Padding="5" IsReadOnly="True" Text="admin"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Cliente Registrado:" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCliente" 
                        Height="30" 
                        Foreground="#2D3748"
                        FontSize="13"
                        IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreDisplay}" 
                        Foreground="#2D3748" 
                        VerticalAlignment="Center" 
                        Margin="2"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Fila 1: Selección de Productos con Código e ID -->
                <Border Grid.Row="1" Background="#F7FAFC" Padding="15" CornerRadius="6" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Entrada por Código numérico -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Cód. / ID" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox x:Name="txtCodigoProducto" Height="28" Margin="0,3,0,0"
                                     PreviewTextInput="TxtCodigoProducto_PreviewTextInput"
                                     KeyDown="TxtCodigoProducto_KeyDown"/>
                        </StackPanel>

                        <!-- Selector desplegable -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Producto / Descripción" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <ComboBox x:Name="cmbProductoBusqueda" Height="28" Margin="0,3,0,0"
                                      SelectedValuePath="IdProducto"
                                      SelectionChanged="CmbProductoBusqueda_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NombreCompletoDisplay}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Precio Unitario -->
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Precio Unitario" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox x:Name="txtPrecioUnitario" Height="28" Margin="0,3,0,0" IsReadOnly="True" Background="#EDF2F7"/>
                        </StackPanel>

                        <!-- Cantidad -->
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="Cantidad" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox x:Name="txtCantidad" Height="28" Margin="0,3,0,0" Text="1"
                                     PreviewTextInput="TxtCantidad_PreviewTextInput"/>
                        </StackPanel>

                        <Button x:Name="btnAgregar" Click="BtnAgregar_Click"
                            Grid.Column="3" Content="Agregar" Width="80" Height="28" VerticalAlignment="Bottom"
                            Background="#E8792D" Foreground="White" Cursor="Hand" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Fila 2: Grilla de Detalle de Venta -->
                <DataGrid x:Name="dgDetalleVenta" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="White" BorderBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Producto" Width="90" Binding="{Binding IdProducto}"/>
                        <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding Nombre}"/>
                        <DataGridTextColumn Header="Precio Venta" Width="110" Binding="{Binding PrecioVenta, StringFormat={}{0:N2}}"/>
                        <DataGridTextColumn Header="Cantidad" Width="90" Binding="{Binding Cantidad}"/>
                        <DataGridTextColumn Header="Subtotal" Width="110" Binding="{Binding Subtotal, StringFormat={}{0:N2}}"/>

                        <DataGridTemplateColumn Header="Eliminar" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Eliminar" Click="BtnEliminarItem_Click" Tag="{Binding}"
                                            Background="#E53E3E" Foreground="White" BorderThickness="0"
                                            Padding="5,2" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Fila 3: Sección de Pago -->
                <Border Grid.Row="3" Background="#F7FAFC" Padding="15" CornerRadius="6" Margin="0,15,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tipo de Pago -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Tipo de Pago" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <ComboBox x:Name="cmbTipoPago" Height="30" Margin="0,3,0,0"
                                      SelectionChanged="CmbTipoPago_SelectionChanged">
                                <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                                <ComboBoxItem Content="Tarjeta"/>
                                <ComboBoxItem Content="Transferencia"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Fecha de Pago -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Fecha de Pago" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <DatePicker x:Name="dpFechaPago" Height="30" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Monto Recibido -->
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Monto Recibido" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox x:Name="txtMontoRecibido" Height="30" Padding="5" Margin="0,3,0,0"
                                     TextChanged="TxtMontoRecibido_TextChanged"/>
                        </StackPanel>

                        <!-- Vuelto -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Vuelto" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox x:Name="txtVuelto" Height="30" Padding="5" Margin="0,3,0,0"
                                     IsReadOnly="True" Background="#EDF2F7" Text="$ 0.00" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fila 4: Total y Botones de Acción -->
                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Precio Total: " FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                        <TextBlock x:Name="txtPrecioTotal" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="#38A169"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnGuardarVenta" Click="BtnGuardarVenta_Click"
                                Content="Guardar Venta" Width="110" Height="38" Background="#38A169"
                                Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"/>
                        <Button x:Name="btnCancelarVenta" Click="BtnCancelarVenta_Click"
                                Content="Cancelar" Width="90" Height="38" Background="#E53E3E"
                                Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>