<Page x:Class="TiendaOga.Vistas.Productos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Gestión de Productos"
      Background="#F4F5F7"
      FontFamily="Segoe UI"
      d:DesignHeight="800" d:DesignWidth="1200">

    <Page.Resources>
        <!-- ===== Paleta de colores ===== -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E8792D"/>
        <!-- Naranja OGA -->
        <SolidColorBrush x:Key="AccentBrushHover" Color="#D96C22"/>

        <!-- ===== Efecto de sombra sutil ===== -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2" Direction="270"/>

        <!-- ===== Estilos Base ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- TextBox y ComboBox -->
        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Botones -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Page.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Grid>

        <!-- =========================================================
             CAPA 1: VISTA PRINCIPAL DE DATOS (Fondo)
        ========================================================== -->
        <Grid Margin="10,10,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título y Botón Nuevo -->
                <RowDefinition Height="*"/>
                <!-- Tarjeta Blanca (Filtros y Tabla) -->
            </Grid.RowDefinitions>

            <!-- Encabezado de la vista -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Productos y Rubros" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Alta, baja y modificación del catálogo" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- BOTÓN PARA ABRIR EL MODAL DE ALTA -->
                <Button Grid.Column="1" Content="+ Nuevo Producto" Style="{StaticResource PrimaryButton}" Click="BtnNuevoProducto_Click"/>
            </Grid>

            <!-- RECUADRO BLANCO (Tarjeta) que envuelve Filtros y Tabla -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Filtros -->
                        <RowDefinition Height="*"/>
                        <!-- Tabla -->
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Filtrar por rubro:" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cmbFiltroCategoria" Style="{StaticResource FlatComboBox}" DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Buscar producto:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtBusqueda" Style="{StaticResource FlatTextBox}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="Buscar" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="34" Padding="16,0" Click="BtnBuscar_Click"/>
                    </Grid>

                    <!-- Tabla de Datos (Estilo Clásico) -->
                    <DataGrid x:Name="dgProductos" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="DgProductos_SelectionChanged"
                              Background="White" FontSize="13" RowHeight="32"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                              BorderBrush="#CCCCCC" BorderThickness="1">

                        <DataGrid.Columns>
                            <!-- Columnas de datos -->
                            <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="80"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding NombreProducto}" Width="*"/>
                            <DataGridTextColumn Header="Rubro" Binding="{Binding NombreCategoria}" Width="150"/>
                            <DataGridTextColumn Header="Costo" Binding="{Binding PrecioCosto, StringFormat={}{0:C}}" Width="120"/>
                            <DataGridTextColumn Header="Venta" Binding="{Binding PrecioVentas, StringFormat={}{0:C}}" Width="120"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>

                            <!-- Columna Estado Visual -->
                            <DataGridTemplateColumn Header="Estado" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Activo" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones: Editar y Eliminar -->
                            <DataGridTemplateColumn Header="Acciones" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" Click="BtnEditar_Click" Tag="{Binding IdProducto}" Margin="0,0,8,0" ToolTip="Editar">
                                                <TextBlock Text="✏️" FontSize="14"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Click="BtnEliminar_Click" Tag="{Binding IdProducto}" ToolTip="Eliminar">
                                                <TextBlock Text="🗑️" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- =========================================================
             CAPA 2: MODAL DE FORMULARIO (Oculto por defecto)
        ========================================================== -->
        <Grid x:Name="ModalFormulario" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
            <!-- Tarjeta del formulario centrada -->
            <Border Style="{StaticResource CardStyle}" Width="850" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>

                    <TextBlock Text="Datos del Producto" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="ID" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtId" Style="{StaticResource FlatTextBox}" IsReadOnly="True" Background="#F7F7F7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Nombre producto" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource FlatTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Precio Costo" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtPrecioCosto" Style="{StaticResource FlatTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Precio Venta" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtPrecioVenta" Style="{StaticResource FlatTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Stock" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtStock" Style="{StaticResource FlatTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Selector de tipo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Tipo de Producto:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbHogar" Content="Hogar" GroupName="TipoProd" IsChecked="True" Checked="TipoProducto_Checked" Margin="0,0,20,0"/>
                        <RadioButton x:Name="rbTecnologia" Content="Tecnología" GroupName="TipoProd" Checked="TipoProducto_Checked"/>
                    </StackPanel>

                    <!-- Paneles condicionales -->
                    <Grid Height="80" Margin="0,0,0,24">
                        <Border x:Name="panelHogar" Background="#FAFAFA" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Material" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtMaterial" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Dimensiones" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtDimensiones" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Peso (kg)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtPeso" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Ambiente" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtAmbiente" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="panelTecnologia" Background="#FAFAFA" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Marca" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtMarca" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Modelo" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtModelo" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Garantía (meses)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtGarantia" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Voltaje" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtVoltaje" Style="{StaticResource FlatTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Botones del Modal -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,16,0" Click="BtnCancelar_Click"/>
                        <Button Content="Guardar Producto" Style="{StaticResource PrimaryButton}" Width="160" Click="BtnGuardar_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>