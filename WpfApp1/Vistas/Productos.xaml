<Page x:Class="TiendaOga.Vistas.Productos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Gestión de Productos"
      Background="#F4F5F7"
      FontFamily="Segoe UI"
      d:DesignHeight="800" d:DesignWidth="1200">

    <Page.Resources>
        <!-- ===== Paleta de colores ===== -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E8792D"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#D96C22"/>
        <SolidColorBrush x:Key="RowInactivoBrush" Color="#F8D7DA"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.08" BlurRadius="16" ShadowDepth="3" Direction="270"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila roja cuando el producto está inactivo -->
        <Style x:Key="FilaProductoStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activo}" Value="False">
                    <Setter Property="Background" Value="{StaticResource RowInactivoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- =========================================================
             CAPA 1: LISTADO PRINCIPAL DE PRODUCTOS
        ========================================================== -->
        <Grid Margin="15,10,15,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Productos y Rubros" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Consulta y administración del catálogo" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Botón Nuevo (Identificado para control de roles) -->
                <Button x:Name="btnNuevoProducto" Grid.Column="1" Content="+ Nuevo Producto" 
                        Style="{StaticResource PrimaryButton}" Click="BtnNuevoProducto_Click"/>
            </Grid>

            <!-- Tarjeta con Filtros y Grilla -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Filtrar por rubro:" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cmbFiltroCategoria" Style="{StaticResource FlatComboBox}" DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Buscar producto:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtBusqueda" Style="{StaticResource FlatTextBox}" Height="34"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Buscar" Style="{StaticResource PrimaryButton}" 
                                VerticalAlignment="Bottom" Height="34" Padding="16,0" Click="BtnBuscar_Click"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgProductos" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="DgProductos_SelectionChanged"
                              RowStyle="{StaticResource FilaProductoStyle}"
                              Background="White" FontSize="13" RowHeight="32"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                              BorderBrush="#CCCCCC" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="60"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding NombreProducto}" Width="2*" MinWidth="200"/>
                            <DataGridTextColumn Header="Rubro" Binding="{Binding NombreCategoria}" Width="1.2*" MinWidth="120"/>
                            <DataGridTextColumn Header="Costo" Binding="{Binding PrecioCosto, StringFormat={}{0:C}}" Width="110"/>
                            <DataGridTextColumn Header="Venta" Binding="{Binding PrecioVentas, StringFormat={}{0:C}}" Width="110"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>

                            <!-- Estado dinámico según Activo -->
                            <DataGridTemplateColumn Header="Estado" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Activo"/>
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Text" Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Columna Acciones (Identificada para control de roles) -->
                            <DataGridTemplateColumn x:Name="columnaAcciones" Header="Acciones" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" Click="BtnEditar_Click" Tag="{Binding IdProducto}" ToolTip="Editar">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3182CE"/>
                                            </Button>

                                            <!-- Tacho / Reactivar: alterna Dar de baja y Reactivar -->
                                            <Button Style="{StaticResource IconButtonStyle}" Click="BtnToggleActivo_Click" Tag="{Binding}" Margin="4,0,0,0">
                                                <Button.ToolTip>
                                                    <ToolTip Content="Dar de baja">
                                                        <ToolTip.Style>
                                                            <Style TargetType="ToolTip">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Content" Value="Reactivar producto"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToolTip.Style>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE74D;"/>
                                                            <Setter Property="Foreground" Value="#E53E3E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Text" Value="&#xE777;"/>
                                                                    <Setter Property="Foreground" Value="#38A169"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- =========================================================
             CAPA 2: MODAL RESPONSIVE Y ADAPTABLE
        ========================================================== -->
        <Grid x:Name="ModalFormulario" Background="#77000000" Visibility="Collapsed" Panel.ZIndex="100">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                <Border Style="{StaticResource CardStyle}" 
                        MaxWidth="720" 
                        Margin="20"
                        HorizontalAlignment="Center" 
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Datos del Producto" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Fila 1: ID y Nombre -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtId" Style="{StaticResource FlatTextBox}" IsReadOnly="True" Background="#F5F5F5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nombre del Producto" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtNombre" Style="{StaticResource FlatTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fila 2: Costo, Venta y Stock -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio Costo ($)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtPrecioCosto" Style="{StaticResource FlatTextBox}" PreviewTextInput="ValidarSoloDecimales"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio Venta ($)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtPrecioVenta" Style="{StaticResource FlatTextBox}" PreviewTextInput="ValidarSoloDecimales"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Stock Disponible" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtStock" Style="{StaticResource FlatTextBox}" PreviewTextInput="ValidarSoloEnteros"/>
                            </StackPanel>
                        </Grid>

                        <!-- Selector de Rubro / Tipo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tipo de Rubro:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbHogar" Content="Hogar" GroupName="TipoProd" IsChecked="True" Checked="TipoProducto_Checked" Margin="0,0,20,0"/>
                            <RadioButton x:Name="rbTecnologia" Content="Tecnología" GroupName="TipoProd" Checked="TipoProducto_Checked"/>
                        </StackPanel>

                        <!-- Atributos Dinámicos -->
                        <Grid Margin="0,0,0,20">
                            <!-- Panel Hogar -->
                            <Border x:Name="panelHogar" Background="#FBFBFB" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Material" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtMaterial" Style="{StaticResource FlatTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dimensiones" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtDimensiones" Style="{StaticResource FlatTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Peso (kg)" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtPeso" Style="{StaticResource FlatTextBox}" PreviewTextInput="ValidarSoloDecimales"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Ambiente" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtAmbiente" Style="{StaticResource FlatTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Panel Tecnología -->
                            <Border x:Name="panelTecnologia" Background="#FBFBFB" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Marca" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtMarca" Style="{StaticResource FlatTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Modelo" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtModelo" Style="{StaticResource FlatTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Garantía (meses)" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtGarantia" Style="{StaticResource FlatTextBox}" PreviewTextInput="ValidarSoloEnteros"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Voltaje" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtVoltaje" Style="{StaticResource FlatTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Botones de Acción -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,14,0" Click="BtnCancelar_Click"/>
                            <Button Content="Guardar Producto" Style="{StaticResource PrimaryButton}" Width="150" Click="BtnGuardar_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>