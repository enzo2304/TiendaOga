<Page x:Class="TiendaOga.Vistas.Usuarios"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TiendaOga.Vistas"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Usuarios"
      Background="#F4F5F7">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Alta de Usuario -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="lblTituloFormulario" Text="Alta de Usuario" Foreground="#2D3748" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="rbAlta" GroupName="ModoOperacion" Content="Alta" IsChecked="True" Checked="ModoOperacion_Checked" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbModificar" GroupName="ModoOperacion" Content="Modificar" Checked="ModoOperacion_Checked" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbBaja" GroupName="ModoOperacion" Content="Dar de Baja" Checked="ModoOperacion_Checked" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAyudaModo" Text="Completá los datos para registrar un nuevo usuario." Foreground="#718096" FontSize="12" Margin="0,4,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNombre" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                     Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                     PreviewTextInput="SoloLetras_PreviewTextInput"
                                     DataObject.Pasting="SoloLetras_Pasting"
                                     MaxLength="100"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Apellido" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtApellido" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                     Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                     PreviewTextInput="SoloLetras_PreviewTextInput"
                                     DataObject.Pasting="SoloLetras_Pasting"
                                     MaxLength="100"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Usuario" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtUsuario" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contraseña" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <PasswordBox x:Name="txtPassword" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                             Padding="8,0,32,0" VerticalContentAlignment="Center" FontSize="13"
                                             PasswordChanged="TxtPassword_PasswordChanged"/>
                                <TextBox x:Name="txtPasswordVisible" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                         Padding="8,0,32,0" VerticalContentAlignment="Center" FontSize="13"
                                         Visibility="Collapsed"
                                         TextChanged="TxtPasswordVisible_TextChanged"/>
                                <ToggleButton x:Name="btnMostrarPassword" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Width="28" Height="26" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                              Content="👁" FontSize="14" Cursor="Hand"
                                              Checked="BtnMostrarPassword_Checked" Unchecked="BtnMostrarPassword_Unchecked"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEmail" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Perfil" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbPerfil" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                      VerticalContentAlignment="Center" FontSize="13"
                                      DisplayMemberPath="NombrePerfil" SelectedValuePath="IdPerfil"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnLimpiar" Click="BtnLimpiar_Click" Content="Limpiar"
                                Height="38" Width="100" Background="#FFFFFF" Foreground="#4A5568"
                                BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button x:Name="btnGuardar" Click="BtnGuardar_Click" Content="Registrar Usuario"
                                Height="38" Width="160" Background="#FF6B00" Foreground="#FFFFFF"
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Usuarios Registrados -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Usuarios Registrados" Foreground="#2D3748" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Buscador -->
                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="txtBuscarUsuario" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                 Padding="30,0,8,0" VerticalContentAlignment="Center" FontSize="13"
                                 TextChanged="TxtBuscarUsuario_TextChanged"/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar usuario..." Foreground="#A0AEC0" FontSize="13" Margin="30,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscarUsuario}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <DataGrid x:Name="dgUsuarios" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="DgUsuarios_SelectionChanged"
                              Height="260" Background="#FFFFFF" BorderThickness="0" RowHeight="34" HeadersVisibility="Column">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Fila inactiva, sin seleccionar -->
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter Property="Background" Value="#FDE2E2"/>
                                        <Setter Property="Foreground" Value="#9B2C2C"/>
                                    </DataTrigger>

                                    <!-- Fila inactiva Y seleccionada: mantiene tono rojo, más oscuro para diferenciar -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Activo}" Value="False"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#F5B7B1"/>
                                        <Setter Property="Foreground" Value="#7B241C"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdUsuario}" Width="50"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="120"/>
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="120"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioLogin}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding NombrePerfil}" Width="120"/>
                            <DataGridTextColumn Header="Activo" Binding="{Binding Activo}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>