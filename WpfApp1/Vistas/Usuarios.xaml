<Page x:Class="TiendaOga.Vistas.Usuarios"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TiendaOga.Vistas"
      xmlns:ayuda="clr-namespace:TiendaOga.Vistas"
      ayuda:Guia.Capitulo="Usuarios y Permisos"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Usuarios"
      Background="#F4F5F7">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Alta de Usuario -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="lblTituloFormulario" Text="Alta de Usuario" Foreground="#2D3748" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                ayuda:Guia.Orden="1" ayuda:Guia.Titulo="Modo de operación"
                                ayuda:Guia.Texto="Elegí qué querés hacer: dar de alta un usuario nuevo, modificar uno existente o darlo de baja. Para modificar o dar de baja, primero seleccioná al usuario en la lista de abajo.">
                        <RadioButton x:Name="rbAlta" GroupName="ModoOperacion" Content="Alta" IsChecked="True" Checked="ModoOperacion_Checked" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbModificar" GroupName="ModoOperacion" Content="Modificar" Checked="ModoOperacion_Checked" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbBaja" GroupName="ModoOperacion" Content="Dar de Baja" Checked="ModoOperacion_Checked" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAyudaModo" Text="Completá los datos para registrar un nuevo usuario." Foreground="#718096" FontSize="12" Margin="0,4,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNombre" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                     Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                     PreviewTextInput="SoloLetras_PreviewTextInput"
                                     DataObject.Pasting="SoloLetras_Pasting"
                                     MaxLength="100"
                                     ayuda:Guia.Orden="2" ayuda:Guia.Titulo="Nombre"
                                     ayuda:Guia.Texto="Nombre de la persona. Solo se aceptan letras."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Apellido" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtApellido" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                     Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                     PreviewTextInput="SoloLetras_PreviewTextInput"
                                     DataObject.Pasting="SoloLetras_Pasting"
                                     MaxLength="100"
                                     ayuda:Guia.Orden="3" ayuda:Guia.Titulo="Apellido"
                                     ayuda:Guia.Texto="Apellido de la persona. Solo se aceptan letras."/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Usuario" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtUsuario" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                     ayuda:Guia.Orden="4" ayuda:Guia.Titulo="Usuario"
                                     ayuda:Guia.Texto="Nombre con el que la persona va a iniciar sesión en el sistema."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contraseña" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <PasswordBox x:Name="txtPassword" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                             Padding="8,0,32,0" VerticalContentAlignment="Center" FontSize="13"
                                             PasswordChanged="TxtPassword_PasswordChanged"
                                             ayuda:Guia.Orden="5" ayuda:Guia.Titulo="Contraseña"
                                             ayuda:Guia.Texto="Contraseña con la que va a ingresar. Para verla mientras la escribís, usá el ojo que está a la derecha."/>
                                <TextBox x:Name="txtPasswordVisible" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                         Padding="8,0,32,0" VerticalContentAlignment="Center" FontSize="13"
                                         Visibility="Collapsed"
                                         TextChanged="TxtPasswordVisible_TextChanged"/>
                                <ToggleButton x:Name="btnMostrarPassword" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Width="28" Height="26" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                              Content="👁" FontSize="14" Cursor="Hand"
                                              Checked="BtnMostrarPassword_Checked" Unchecked="BtnMostrarPassword_Unchecked"
                                              ayuda:Guia.Orden="6" ayuda:Guia.Titulo="Mostrar contraseña"
                                              ayuda:Guia.Texto="Muestra u oculta lo que escribiste en la contraseña, para que verifiques que está bien."/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEmail" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                     ayuda:Guia.Orden="7" ayuda:Guia.Titulo="Email"
                                     ayuda:Guia.Texto="Correo electrónico de la persona."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Perfil" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbPerfil" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                      VerticalContentAlignment="Center" FontSize="13"
                                      DisplayMemberPath="NombrePerfil" SelectedValuePath="IdPerfil"
                                      ayuda:Guia.Orden="8" ayuda:Guia.Titulo="Perfil"
                                      ayuda:Guia.Texto="El perfil define el rol del usuario y, con eso, a qué pantallas y acciones puede acceder."/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnLimpiar" Click="BtnLimpiar_Click" Content="Limpiar"
                                Height="38" Width="100" Background="#FFFFFF" Foreground="#4A5568"
                                BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,10,0" Cursor="Hand"
                                ayuda:Guia.Orden="9" ayuda:Guia.Titulo="Limpiar"
                                ayuda:Guia.Texto="Vacía el formulario para empezar de nuevo."/>
                        <Button x:Name="btnGuardar" Click="BtnGuardar_Click" Content="Registrar Usuario"
                                Height="38" Width="160" Background="#FF6B00" Foreground="#FFFFFF"
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ayuda:Guia.Orden="10" ayuda:Guia.Titulo="Confirmar"
                                ayuda:Guia.Texto="Ejecuta la operación elegida arriba: registrar, modificar o dar de baja al usuario. El texto del botón cambia según el modo."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Usuarios Registrados -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Usuarios Registrados" Foreground="#2D3748" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Buscador -->
                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="txtBuscarUsuario" Height="36" Background="#FAFAFA" BorderBrush="#CBD5E0" BorderThickness="1"
                                 Padding="30,0,8,0" VerticalContentAlignment="Center" FontSize="13"
                                 TextChanged="TxtBuscarUsuario_TextChanged"
                                 ayuda:Guia.Orden="11" ayuda:Guia.Titulo="Buscar usuario"
                                 ayuda:Guia.Texto="Escribí para filtrar la lista de usuarios registrados."/>
                        <TextBlock Text="🔍" FontSize="13" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar usuario..." Foreground="#A0AEC0" FontSize="13" Margin="30,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscarUsuario}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <DataGrid x:Name="dgUsuarios" AutoGenerateColumns="False" IsReadOnly="True"
          SelectionChanged="DgUsuarios_SelectionChanged"
          Height="260" Background="#FFFFFF" BorderThickness="0" RowHeight="42" HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#EEF0F2"
          VerticalGridLinesBrush="Transparent"
          CanUserResizeRows="False"
          CanUserResizeColumns="False"
          CanUserReorderColumns="False"
          HorizontalScrollBarVisibility="Disabled"
          ayuda:Guia.Orden="12" ayuda:Guia.Titulo="Usuarios registrados"
          ayuda:Guia.Texto="Lista de usuarios con su perfil y su estado. Los usuarios dados de baja aparecen en rojo. Al seleccionar uno, sus datos pasan al formulario de arriba para modificarlo o darlo de baja. Si hay muchos usuarios, los botones de paginación de abajo permiten cambiar de página.">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#4A5568"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="16,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#4A5568"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFF1E6"/>
                                        <Setter Property="Foreground" Value="#2D3748"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter Property="Background" Value="#F8D7DA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdUsuario}" Width="50"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="120"/>
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="120"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioLogin}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding NombrePerfil}" Width="120"/>
                            <DataGridTextColumn Header="Activo" Binding="{Binding Activo}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Paginación -->
                    <StackPanel x:Name="pnlPaginacion" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
