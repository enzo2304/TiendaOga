<Page x:Class="TiendaOga.Vistas.ReporteProductos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:ayuda="clr-namespace:TiendaOga.Vistas"
      Title="Reporte de Ventas" Background="#F4F5F7" FontFamily="Segoe UI"
      ayuda:Guia.Capitulo="Reporte de productos">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="250"/>
            <!-- Gráficos Top -->
            <RowDefinition Height="250"/>
            <!-- Gráficos Detalle -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Panel de Análisis de Rentabilidad" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Haga clic en las barras de los gráficos superiores para ver el detalle de cada producto." FontSize="13" Foreground="#E8792D" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Filtros: rango de fechas (mes completo o un día puntual) -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1"
                ayuda:Guia.Orden="1"
                ayuda:Guia.Titulo="Período a analizar"
                ayuda:Guia.Texto="Elegí las fechas Desde y Hasta. Para ver un día puntual poné la misma fecha en ambas; para un mes, del día 1 al último. El reporte se actualiza solo al cambiar una fecha.">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Desde:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpDesde" Width="120" Margin="0,0,15,0" SelectedDateChanged="FiltroFecha_SelectedDateChanged"/>

                <TextBlock Text="Hasta:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpHasta" Width="120" Margin="0,0,20,0" SelectedDateChanged="FiltroFecha_SelectedDateChanged"/>

                <Button Content="Refrescar"
                ayuda:Guia.Orden="2"
                ayuda:Guia.Titulo="Refrescar"
                ayuda:Guia.Texto="Vuelve a consultar los datos con las fechas elegidas. Si Desde es posterior a Hasta, te avisa." Width="90" Height="30" Background="#E8792D" Foreground="White" Click="BtnGenerar_Click" Margin="0,0,10,0"/>
                <Button Content="Ver General (Borrar Filtro)"
                ayuda:Guia.Orden="3"
                ayuda:Guia.Titulo="Volver a la vista general"
                ayuda:Guia.Texto="Después de hacer clic en un producto, este botón devuelve la torta y el comparativo al total de todo el catálogo. No borra las fechas." Width="170" Height="30" Background="#666666" Foreground="White" Click="BtnRestablecer_Click"/>
            </WrapPanel>
        </Border>

        <!-- FILA DE GRÁFICOS SUPERIOR: Los "Clickeables" -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,10,0"
                    ayuda:Guia.Orden="4"
                    ayuda:Guia.Titulo="Más vendidos (unidades)"
                    ayuda:Guia.Texto="Los 5 productos con más unidades vendidas en el período. Hacé clic en una barra para ver el detalle de ese producto abajo.">
                <Grid>
                    <TextBlock Text="Más Vendidos (Unidades)" FontWeight="Bold" Margin="0,0,0,10"/>
                    <lvc:CartesianChart x:Name="graficoTopUnidades" Margin="0,20,0,0" DataClick="GraficoUnidades_DataClick" Cursor="Hand">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis x:Name="ejeXUnidades"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MinValue="0"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10"
                    ayuda:Guia.Orden="5"
                    ayuda:Guia.Titulo="Más rentables (ganancia neta)"
                    ayuda:Guia.Texto="Los 5 productos que más ganancia dejaron (ingreso menos costo). También podés hacer clic en una barra.">
                <Grid>
                    <TextBlock Text="Más Rentables (Ganancia Neta $)" FontWeight="Bold" Margin="0,0,0,10"/>
                    <lvc:CartesianChart x:Name="graficoTopRentables" Margin="0,20,0,0" DataClick="GraficoRentables_DataClick" Cursor="Hand">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis x:Name="ejeXRentables"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MinValue="0" LabelFormatter="{Binding FormatoMoneda}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>

        <!-- FILA DE GRÁFICOS INFERIOR: Los "Dinámicos" -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,10,0"
                    ayuda:Guia.Orden="6"
                    ayuda:Guia.Titulo="Distribución de cobranza"
                    ayuda:Guia.Texto="Muestra con qué métodos de pago se cobró. Si elegiste un producto, muestra solo el de ese producto.">
                <Grid>
                    <TextBlock x:Name="lblTituloTorta" Text="Distribución de Cobranza (General)" FontWeight="Bold" Margin="0,0,0,10"/>
                    <lvc:PieChart x:Name="graficoPagos" Margin="0,20,0,0" LegendLocation="Right" InnerRadius="20"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10"
                    ayuda:Guia.Orden="7"
                    ayuda:Guia.Titulo="Bruto vs. neto"
                    ayuda:Guia.Texto="Compara el ingreso bruto con la ganancia neta: de todo el catálogo, o del producto que hayas seleccionado.">
                <Grid>
                    <TextBlock x:Name="lblTituloComparativo" Text="Bruto vs Neto (General Promedio)" FontWeight="Bold" Margin="0,0,0,10"/>
                    <lvc:CartesianChart x:Name="graficoComparativo" Margin="0,20,0,0">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis x:Name="ejeXComparativo"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MinValue="0" LabelFormatter="{Binding FormatoMoneda}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>

        <!-- GRILLA -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10"
                ayuda:Guia.Orden="8"
                ayuda:Guia.Titulo="Detalle por producto"
                ayuda:Guia.Texto="Todos los productos vendidos en el período, con su ingreso bruto, ganancia neta y stock actual.">
            <DataGrid x:Name="dgReporte" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Posicion}"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="2*"/>
                    <DataGridTextColumn Header="Ingreso Bruto" Binding="{Binding TotalIngreso, StringFormat={}{0:C}}"/>
                    <DataGridTextColumn Header="Ganancia Neta" Binding="{Binding GananciaNeta, StringFormat={}{0:C}}"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
