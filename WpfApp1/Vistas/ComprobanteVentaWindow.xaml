<Window x:Class="TiendaOga.Vistas.ComprobanteVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprobante de venta" Width="500" SizeToContent="Height" MaxHeight="950"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F2F3F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" HorizontalAlignment="Center">

            <Border Background="White" CornerRadius="10" Padding="14">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="1.35" ScaleY="1.35"/>
                </Border.LayoutTransform>

                <StackPanel x:Name="Ticket" Width="302" Background="White"
                            TextElement.FontFamily="Courier New" TextElement.FontSize="11">

                    <TextBlock x:Name="txtComercio" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock x:Name="txtSubtitulo" FontSize="10" TextAlignment="Center"/>

                    <Line X1="0" X2="1" Stretch="Fill" Stroke="#555" StrokeThickness="1" StrokeDashArray="3 3" Margin="0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="N° Venta:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtNumero" TextAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Fecha:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtFecha" TextAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="Cliente:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtCliente" TextAlignment="Right" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="Vendedor:"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtVendedor" TextAlignment="Right" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Text="Pago:"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtPago" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>


                    <Line X1="0" X2="1" Stretch="Fill" Stroke="#555" StrokeThickness="1" StrokeDashArray="3 3" Margin="0,10"/>

                    <Border BorderBrush="Black" BorderThickness="0,0,0,1" Padding="0,0,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="66"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cant" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Producto" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Precio" FontWeight="Bold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Subtotal" FontWeight="Bold" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="lstItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="66"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Cantidad}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Producto}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Precio}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Subtotal}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0">
                        <Grid>
                            <TextBlock Text="TOTAL" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTotal" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Line X1="0" X2="1" Stretch="Fill" Stroke="#555" StrokeThickness="1" StrokeDashArray="3 3" Margin="0,10"/>

                    <TextBlock x:Name="txtPie" FontSize="10" TextAlignment="Center"/>
                    <TextBlock Text="Comprobante no válido como factura" FontSize="9"
                               FontStyle="Italic" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Botones: quedan fuera del ticket para que no se impriman -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Content="Imprimir" Width="110" Height="36" Margin="4"
                        Background="#1F3A5F" Foreground="White" FontWeight="Bold" Click="BtnImprimir_Click"/>
                <Button Content="Guardar PDF" Width="110" Height="36" Margin="4"
                        Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="BtnGuardarPdf_Click"/>
                <Button Content="Cerrar" Width="90" Height="36" Margin="4" Click="BtnCerrar_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>