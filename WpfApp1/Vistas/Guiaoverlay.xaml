<UserControl x:Class="TiendaOga.Vistas.GuiaOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True" FontFamily="Segoe UI">

    <!-- Background="Transparent" hace que toda la superficie capture los clics mientras la guía está activa -->
    <Grid x:Name="raiz" Background="Transparent" SizeChanged="Raiz_SizeChanged">

        <!-- Fondo oscuro con un hueco sobre el elemento resaltado (se arma en código) -->
        <Path x:Name="fondo" Fill="#A6101828" IsHitTestVisible="False"/>

        <!-- Marco alrededor del elemento resaltado -->
        <Border x:Name="marco" BorderBrush="#E8792D" BorderThickness="2" CornerRadius="6"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- Tarjeta con el texto y la navegación -->
        <Border x:Name="tarjeta" Width="360" Background="White" CornerRadius="10" Padding="18,14,18,14"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"/>
            </Border.Effect>

            <StackPanel>
                <Grid>
                    <TextBlock x:Name="txtProgreso" FontSize="11" FontWeight="SemiBold" Foreground="#718096"
                               VerticalAlignment="Center"/>
                    <Button x:Name="btnCerrar" HorizontalAlignment="Right" Width="26" Height="26"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cerrar (Esc)"
                            Click="Cerrar_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4A5568"/>
                    </Button>
                </Grid>

                <TextBlock x:Name="txtTitulo" FontSize="16" FontWeight="Bold" Foreground="#1A202C"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="txtTexto" FontSize="13" Foreground="#4A5568"
                           TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/>

                <Grid Margin="0,16,0,0">
                    <Button x:Name="btnSaltar" Content="Saltar guía" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Foreground="#4A5568" Cursor="Hand"
                            Padding="4,6" Click="Cerrar_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAnterior" Content="Anterior" Width="84" Height="32" Margin="0,0,8,0"
                                Cursor="Hand" Click="Anterior_Click"/>
                        <Button x:Name="btnSiguiente" Content="Siguiente" Width="100" Height="32"
                                Background="#E8792D" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                                Cursor="Hand" Click="Siguiente_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
