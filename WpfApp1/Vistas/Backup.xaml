<Page x:Class="TiendaOga.Vistas.Backup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Backup"
      Background="#F4F5F7"
      FontFamily="Segoe UI"
      d:DesignHeight="600" d:DesignWidth="1000">

    <Page.Resources>

        <!-- **** Tarjeta base (Card) **** -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" Direction="270" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- **** Tipografía **** -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- **** TextBox **** -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DADFE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F7F8F9"/>
                    <Setter Property="Foreground" Value="#8A8F98"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- **** Botón primario (naranja) **** -->
        <Style x:Key="ButtonPrimaryStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8792D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderBtn" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderBtn" Property="Background" Value="#D66E12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borderBtn" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- **** Botón secundario (blanco con borde) **** -->
        <Style x:Key="ButtonSecondaryStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderBrush" Value="#DADFE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borderBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderBtn" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- **** ENCABEZADO **** -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Copia de Seguridad (Backup)" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Respaldo y protección de la base de datos" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- **** TARJETA CENTRAL **** -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" MaxWidth="700" Width="700"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,30,0,0">
            <StackPanel>

                <!-- Fila 1: Base de datos origen -->
                <TextBlock Text="Base de Datos Origen:" Style="{StaticResource FieldLabelStyle}"/>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                             Text="TiendaOga_DB" IsReadOnly="True" IsEnabled="False"/>

                    <Border Grid.Column="2" Background="#E5F6EA" CornerRadius="6" Padding="12,0" Height="38">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#2F9E58" Margin="0,0,7,0"/>
                            <TextBlock Text="Conectado" Foreground="#2F9E58" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fila 2: Ruta de destino -->
                <TextBlock Text="Ruta para Guardar:" Style="{StaticResource FieldLabelStyle}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtRuta" Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                             IsReadOnly="True" ToolTip="Elegí dónde guardar el archivo de backup"/>

                    <Button x:Name="btnExaminar" Grid.Column="2" Content="Examinar..."
                            Style="{StaticResource ButtonSecondaryStyle}" Click="btnExaminar_Click"/>
                </Grid>
                <TextBlock Text="Se va a generar un archivo .txt con el respaldo de la base." Style="{StaticResource HelperTextStyle}" Margin="0,0,0,26"/>

                <!-- Fila 3: Acción principal -->
                <Button x:Name="btnGenerarBackup" Content="Generar Copia de Seguridad"
                        Style="{StaticResource ButtonPrimaryStyle}" HorizontalAlignment="Right"
                        Click="btnGenerarBackup_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
