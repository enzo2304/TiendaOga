<Page x:Class="TiendaOga.Vistas.ReporteGeneral"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:ayuda="clr-namespace:TiendaOga.Vistas"
      ayuda:Guia.Capitulo="Reporte General"
      Title="Reporte General"
      Background="#F4F5F7"
      FontFamily="Segoe UI"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="KpiIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="TableHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableCellSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="Foreground" Value="#666666"/>
        </Style>
        <Style x:Key="TableRowBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EDEDED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F5F7">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- KPIs -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                        ayuda:Guia.Orden="1" ayuda:Guia.Titulo="Ganancia neta del mes"
                        ayuda:Guia.Texto="Muestra la ganancia neta del mes actual: lo que queda después de descontar el costo de lo vendido.">
                    <StackPanel>
                        <TextBlock Text="📈" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Ganancia Neta (Mes)" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock x:Name="txtGanancia" Text="$ 0" Style="{StaticResource KpiValueStyle}" Foreground="#2FA35A"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0"
                        ayuda:Guia.Orden="2" ayuda:Guia.Titulo="Capital en inventario"
                        ayuda:Guia.Texto="Es el valor de toda la mercadería en stock calculado a precio de costo, no de venta.">
                    <StackPanel>
                        <TextBlock Text="🏦" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Capital en Inventario (a costo)" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock x:Name="txtCapital" Text="$ 0" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0"
                        ayuda:Guia.Orden="3" ayuda:Guia.Titulo="Mejor vendedor"
                        ayuda:Guia.Texto="Nombre del vendedor que lidera el ranking del mes. El detalle de todos los vendedores está más abajo, en Rendimiento del Personal.">
                    <StackPanel>
                        <TextBlock Text="🏆" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Mejor Vendedor" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock x:Name="txtMejorVendedor" Text="-" Style="{StaticResource KpiValueStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0"
                        ayuda:Guia.Orden="4" ayuda:Guia.Titulo="Alertas de stock"
                        ayuda:Guia.Texto="Cantidad de productos que están por debajo del stock mínimo establecido. El listado completo está abajo, en Alerta de Stock Crítico.">
                    <StackPanel>
                        <TextBlock Text="⚠️" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Alertas de Stock" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock x:Name="txtAlertas" Text="0" Style="{StaticResource KpiValueStyle}" Foreground="#D6483F"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Gráficos -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Evolución de Rentabilidad" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Ingresos Brutos vs. Ganancia Neta (6 meses)" Style="{StaticResource SectionSubtitleStyle}"/>
                        <lvc:CartesianChart x:Name="graficoRentabilidad" Height="260" LegendLocation="Bottom"
                                            ayuda:Guia.Orden="5" ayuda:Guia.Titulo="Evolución de rentabilidad"
                                            ayuda:Guia.Texto="Compara mes a mes los ingresos brutos con la ganancia neta de los últimos 6 meses. Sirve para ver si el negocio está mejorando o empeorando.">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis x:Name="ejeXMeses">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis x:Name="ejeYRent" MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ingresos por Medio de Pago" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Liquidez del mes actual" Style="{StaticResource SectionSubtitleStyle}"/>
                        <lvc:PieChart x:Name="graficoPagos" Height="260" LegendLocation="Bottom" InnerRadius="40"
                                      ayuda:Guia.Orden="6" ayuda:Guia.Titulo="Ingresos por medio de pago"
                                      ayuda:Guia.Texto="Muestra cómo se reparte lo cobrado en el mes actual según el medio de pago. La leyenda de abajo indica el color de cada uno."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tablas -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                        ayuda:Guia.Orden="7" ayuda:Guia.Titulo="Rendimiento del personal"
                        ayuda:Guia.Texto="Ranking de los vendedores del mes con su cantidad de ventas y el monto recaudado. Si no hubo ventas, se muestra un aviso.">
                    <StackPanel>
                        <TextBlock Text="Rendimiento del Personal" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Top vendedores del mes" Style="{StaticResource SectionSubtitleStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VENDEDOR" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="CANT. VENTAS" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="RECAUDADO" Style="{StaticResource TableHeaderCellStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl x:Name="listaVendedores">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRowBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Vendedor}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CantVentas}" Style="{StaticResource TableCellSecondaryStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Recaudado}" Style="{StaticResource TableCellStyle}" Foreground="#2FA35A" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="txtSinVendedores" Text="Sin ventas en el mes." Style="{StaticResource TableCellSecondaryStyle}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}"
                        ayuda:Guia.Orden="8" ayuda:Guia.Titulo="Alerta de stock crítico"
                        ayuda:Guia.Texto="Lista los productos que están por debajo del mínimo establecido, con su categoría y el stock que les queda. Son los que conviene reponer. Si no hay ninguno, se muestra un aviso.">
                    <StackPanel>
                        <TextBlock Text="Alerta de Stock Crítico" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Productos por debajo del mínimo establecido" Style="{StaticResource SectionSubtitleStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PRODUCTO" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="STOCK" Style="{StaticResource TableHeaderCellStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl x:Name="listaStock">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRowBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Producto}" Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Categoria}" Style="{StaticResource TableCellSecondaryStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Stock}" FontWeight="Bold" Foreground="{Binding Color}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="txtSinAlertas" Text="Sin productos en alerta." Style="{StaticResource TableCellSecondaryStyle}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
