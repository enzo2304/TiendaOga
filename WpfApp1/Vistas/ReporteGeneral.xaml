<Page x:Class="TiendaOga.Vistas.ReporteGeneral"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Panel Gerencial"
      Background="#F4F5F7"
      FontFamily="Segoe UI"
      d:DesignHeight="900" d:DesignWidth="1200">

    <Page.Resources>
        <!-- **** Tarjeta base (Card) **** -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" Direction="270" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- **** Tipografia **** -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- **** KPI **** -->
        <Style x:Key="KpiIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- **** Tablas **** -->
        <Style x:Key="TableHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableCellSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="Foreground" Value="#666666"/>
        </Style>
        <Style x:Key="TableRowBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EDEDED"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F5F7">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==== FILA DE KPIs ESTRATÉGICOS ==== -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">

                <!-- KPI 1: Ganancia Neta -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="📈" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Ganancia Neta (Mes)" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="$45.800" Style="{StaticResource KpiValueStyle}" Foreground="#2FA35A"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Capital en Inventario -->
                <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="🏦" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Capital en Inventario" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="$850.450" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Vendedor Destacado -->
                <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="🏆" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Mejor Vendedor" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="J. Perez" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Stock Crítico -->
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="⚠️" Style="{StaticResource KpiIconStyle}"/>
                        <TextBlock Text="Alertas de Stock" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="14" Style="{StaticResource KpiValueStyle}" Foreground="#D6483F"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==== GRAFICOS ==== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- **** Rentabilidad **** -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Evolución de Rentabilidad" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Ingresos Brutos vs. Ganancia Neta (6 meses)" Style="{StaticResource SectionSubtitleStyle}"/>

                        <Grid Height="180">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="10,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Bottom" Text="Abr" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                                <Border DockPanel.Dock="Bottom" Background="#2FA35A" CornerRadius="4,4,0,0" Height="45" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <Border DockPanel.Dock="Bottom" Background="#E8792D" CornerRadius="4,4,0,0" Height="95" VerticalAlignment="Bottom" Opacity="0.5"/>
                            </DockPanel>

                            <DockPanel Grid.Column="1" Margin="10,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Bottom" Text="May" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                                <Border DockPanel.Dock="Bottom" Background="#2FA35A" CornerRadius="4,4,0,0" Height="60" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <Border DockPanel.Dock="Bottom" Background="#E8792D" CornerRadius="4,4,0,0" Height="120" VerticalAlignment="Bottom" Opacity="0.5"/>
                            </DockPanel>

                            <DockPanel Grid.Column="2" Margin="10,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Bottom" Text="Jun" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                                <Border DockPanel.Dock="Bottom" Background="#2FA35A" CornerRadius="4,4,0,0" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <Border DockPanel.Dock="Bottom" Background="#E8792D" CornerRadius="4,4,0,0" Height="80" VerticalAlignment="Bottom" Opacity="0.5"/>
                            </DockPanel>

                            <DockPanel Grid.Column="3" Margin="10,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Bottom" Text="Jul" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                                <Border DockPanel.Dock="Bottom" Background="#2FA35A" CornerRadius="4,4,0,0" Height="65" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <Border DockPanel.Dock="Bottom" Background="#E8792D" CornerRadius="4,4,0,0" Height="145" VerticalAlignment="Bottom" Opacity="0.5"/>
                            </DockPanel>

                            <DockPanel Grid.Column="4" Margin="10,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Bottom" Text="Ago" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                                <Border DockPanel.Dock="Bottom" Background="#2FA35A" CornerRadius="4,4,0,0" Height="40" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <Border DockPanel.Dock="Bottom" Background="#E8792D" CornerRadius="4,4,0,0" Height="110" VerticalAlignment="Bottom" Opacity="0.5"/>
                            </DockPanel>

                            <DockPanel Grid.Column="5" Margin="10,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Bottom" Text="Sep" HorizontalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                                <Border DockPanel.Dock="Bottom" Background="#2FA35A" CornerRadius="4,4,0,0" Height="75" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                <Border DockPanel.Dock="Bottom" Background="#E8792D" CornerRadius="4,4,0,0" Height="160" VerticalAlignment="Bottom" Opacity="0.5"/>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- **** Métodos de Pago **** -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ingresos por Medio de Pago" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Liquidez del mes actual" Style="{StaticResource SectionSubtitleStyle}"/>

                        <!-- Efectivo 55% -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="55%" FontWeight="SemiBold" FontSize="12" Foreground="#333333" DockPanel.Dock="Right"/>
                                <TextBlock Text="Efectivo" FontSize="12" Foreground="#333333"/>
                            </DockPanel>
                            <Border Grid.Row="1" Height="8" CornerRadius="4" Background="#F0F0F0">
                                <Border HorizontalAlignment="Left" Width="140" Height="8" CornerRadius="4" Background="#2FA35A"/>
                            </Border>
                        </Grid>

                        <!-- Transferencia 30% -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="30%" FontWeight="SemiBold" FontSize="12" Foreground="#333333" DockPanel.Dock="Right"/>
                                <TextBlock Text="Transferencia / Billetera" FontSize="12" Foreground="#333333"/>
                            </DockPanel>
                            <Border Grid.Row="1" Height="8" CornerRadius="4" Background="#F0F0F0">
                                <Border HorizontalAlignment="Left" Width="75" Height="8" CornerRadius="4" Background="#3B82C4"/>
                            </Border>
                        </Grid>

                        <!-- Tarjeta 15% -->
                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="15%" FontWeight="SemiBold" FontSize="12" Foreground="#333333" DockPanel.Dock="Right"/>
                                <TextBlock Text="Tarjeta (Débito/Crédito)" FontSize="12" Foreground="#333333"/>
                            </DockPanel>
                            <Border Grid.Row="1" Height="8" CornerRadius="4" Background="#F0F0F0">
                                <Border HorizontalAlignment="Left" Width="40" Height="8" CornerRadius="4" Background="#E8792D"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==== TABLAS ==== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- **** Ranking de Personal **** -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Rendimiento del Personal" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Top vendedores del mes" Style="{StaticResource SectionSubtitleStyle}"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VENDEDOR" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="CANT. VENTAS" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="RECAUDADO" Style="{StaticResource TableHeaderCellStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Style="{StaticResource TableRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="J. Perez" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="45" Style="{StaticResource TableCellSecondaryStyle}"/>
                                <TextBlock Grid.Column="2" Text="$52.120" Style="{StaticResource TableCellStyle}" Foreground="#2FA35A" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TableRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="E. Sanchez" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="38" Style="{StaticResource TableCellSecondaryStyle}"/>
                                <TextBlock Grid.Column="2" Text="$41.650" Style="{StaticResource TableCellStyle}" Foreground="#2FA35A" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border BorderThickness="0" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="M. Gomez" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="22" Style="{StaticResource TableCellSecondaryStyle}"/>
                                <TextBlock Grid.Column="2" Text="$28.200" Style="{StaticResource TableCellStyle}" Foreground="#2FA35A" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- **** Alerta de stock critico **** -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Alerta de Stock Crítico" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Productos por debajo del mínimo establecido" Style="{StaticResource SectionSubtitleStyle}"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PRODUCTO" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="CATEGORÍA" Style="{StaticResource TableHeaderCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="STOCK" Style="{StaticResource TableHeaderCellStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Style="{StaticResource TableRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Amoladora angular 4½”" Style="{StaticResource TableCellStyle}"/>
                                <TextBlock Grid.Column="1" Text="Herramientas" Style="{StaticResource TableCellSecondaryStyle}"/>
                                <TextBlock Grid.Column="2" Text="2" FontWeight="Bold" Foreground="#D6483F" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TableRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Microondas 20L" Style="{StaticResource TableCellStyle}"/>
                                <TextBlock Grid.Column="1" Text="Electrodomésticos" Style="{StaticResource TableCellSecondaryStyle}"/>
                                <TextBlock Grid.Column="2" Text="0" FontWeight="Bold" Foreground="#D6483F" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border BorderThickness="0" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Set de destornilladores" Style="{StaticResource TableCellStyle}"/>
                                <TextBlock Grid.Column="1" Text="Herramientas" Style="{StaticResource TableCellSecondaryStyle}"/>
                                <TextBlock Grid.Column="2" Text="3" FontWeight="Bold" Foreground="#E8792D" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>