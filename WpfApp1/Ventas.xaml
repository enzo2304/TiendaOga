<Page x:Class="TiendaOga.Ventas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ventas">

    <!-- Contenedor del Formulario de Venta (Solo la parte central) -->
    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nueva Venta" FontSize="22" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Vendedor y Cliente -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Vendedor:" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtVendedor" Height="30" Padding="5" IsReadOnly="True" Text="admin"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Cliente:" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtCliente" Height="30" Padding="5"/>
                            <Button Grid.Column="1" Content="Buscar" Width="75" Height="30" Margin="5,0,0,0" Background="#EDF2F7" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Selección de Productos -->
                <Border Grid.Row="1" Background="#F7FAFC" Padding="15" CornerRadius="6" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Producto / Descripción" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox Height="28" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Precio Unitario" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox Height="28" Margin="0,3,0,0" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Cantidad" FontSize="11" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBox Height="28" Margin="0,3,0,0" Text="1"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="Agregar" Width="80" Height="28" VerticalAlignment="Bottom" Background="#3182CE" Foreground="White" Cursor="Hand" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Fila 3: Grilla de Detalle de Venta (Corregida) -->
                <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID Producto" Width="90" Binding="{Binding id_producto}"/>
                        <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding nombre}"/>
                        <DataGridTextColumn Header="Precio Venta" Width="110" Binding="{Binding precio_ventas}"/>
                        <DataGridTextColumn Header="Cantidad" Width="90" Binding="{Binding cantidad}"/>

                        <DataGridTemplateColumn Header="Eliminar" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Eliminar" Background="#E53E3E" Foreground="White" BorderThickness="0" Padding="5,2" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Fila 4: Total y Botones de Acción -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Precio Total: " FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                        <TextBlock x:Name="txtPrecioTotal" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="#38A169"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Guardar Venta" Width="110" Height="38" Background="#38A169" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"/>
                        <Button Content="Cancelar" Width="90" Height="38" Background="#E53E3E" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>