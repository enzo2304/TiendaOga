<Window x:Class="TiendaOga.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tienda OGA - Dashboard" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Background="#12121A">
    <!-- Fondo oscuro principal -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Ancho del Menú Lateral -->
            <ColumnDefinition Width="*"/>
            <!-- Resto de la pantalla -->
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- 1. MENÚ LATERAL (SIDEBAR)                  -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#1A1A24" BorderBrush="#252530" BorderThickness="0,0,1,0" Padding="15,20,15,0">
            <StackPanel>
                <!-- Logo Tienda OGA -->
                <TextBlock Text="🏪 TIENDA OGA" Foreground="#B2FF05" FontSize="20" FontWeight="Bold" Margin="0,0,0,40"/>

                <!-- Todos los botones ahora tienen el mismo estilo inactivo -->
                <Button x:Name="btnMenuUsuarios" Click="btnMenuUsuarios_Click" Content="Usuarios" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,0,0,10"/>
                <Button x:Name="btnMenuBackUp" Click="btnMenuBackUp_Click" Content="Back Up" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,0,0,10"/>
                <Button x:Name="btnMenuVentas" Click="btnMenuVentas_Click" Content="Ventas" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,0,0,10"/>
                <Button x:Name="btnMenuClientes" Click="btnMenuClientes_Click" Content="Clientes" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,0,0,10"/>
                <Button x:Name="btnMenuProductos" Click="btnMenuProductos_Click" Content="Productos" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,0,0,10"/>
                <Button x:Name="btnMenuReportes" Click="btnMenuReportes_Click" Content="Reportes" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,0,0,10"/>

                <!-- Botón Salir -->
                <Button x:Name="btnMenuSalir" Click="btnMenuSalir_Click" Content="Salir" Background="Transparent" Foreground="#FF4C4C" BorderThickness="0" Height="40" HorizontalAlignment="Left" Margin="10,40,0,10"/>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 2. CONTENIDO PRINCIPAL (INICIO)            -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Espacio de bienvenida -->
            </Grid.RowDefinitions>

            <!-- HEADER GENÉRICO -->
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <!-- Títulos cambiados para una pantalla de inicio -->
                    <TextBlock x:Name="txtTituloSeccion" Text="Menú Principal" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSubtituloSeccion" Text="Seleccione un módulo en el menú lateral para comenzar." Foreground="#808080" FontSize="14"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtRolActual" Text="Administrador" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- PANTALLA DE BIENVENIDA -->
            <Border Grid.Row="1" Background="#1E1E28" CornerRadius="10" Margin="0,20,0,0" Padding="20">
                <!-- Un mensaje amigable o el logo grande para rellenar el espacio vacío -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🏪" FontFamily="Segoe UI Emoji" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Bienvenido al Sistema de Gestión" Foreground="#A0A0A0" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Utilice la barra lateral para navegar por las distintas opciones." Foreground="#555" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>